#!/bin/bash

# data plane interfaces (without IP addresses)
ip link set eth0 up
ip link set eth1 up

# control plane management interface 
ip addr add 10.0.0.2/24 dev eth2
ip link set eth2 up

# OVS daemon 
service openvswitch-switch start

# OVS bridge 
ovs-vsctl add-br br0
ovs-vsctl set bridge br0 stp_enable=true

# data interfaces to bridge links
ovs-vsctl add-port br0 eth0
ovs-vsctl add-port br0 eth1

# OpenFlow protocol version 1.0 for POX compatibility
ovs-vsctl set bridge br0 protocols=OpenFlow10

# SDN controller link
ovs-vsctl set-controller br0 tcp:10.0.0.100:6653
ovs-vsctl set-fail-mode br0 secure
