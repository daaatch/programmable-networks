#!/bin/bash

# enable ipv4 routing
sysctl -w net.ipv4.ip_forward=1 

# configure interfaces
ip addr add 192.168.2.1/24 dev eth0
ip addr add 10.0.12.2/30 dev eth1
ip addr add 10.0.23.1/30 dev eth2

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

# static routes to remote LANs
ip route add 192.168.1.0/24 via 10.0.12.1
ip route add 192.168.3.0/24 via 10.0.23.2
